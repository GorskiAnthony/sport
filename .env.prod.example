# Variables à renseigner dans Dokploy (onglet Environment du projet), PAS dans un fichier
# .env commité. Copie ce template comme référence.

# Postgres
POSTGRES_DB=tournoi_center
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                     # généré avec: openssl rand -base64 24

# Backend
JWT_SECRET=                            # généré avec: openssl rand -base64 32
JWT_EXPIRATION_DAYS=7
CLIENT_URL=https://sport.example.com   # domaine du frontend en prod (utilisé pour CORS)
MOBILE_URL=https://m.sport.example.com # domaine du build web de l'app mobile (lien du QR arbitre) — pas encore déployé, voir mobile/README.md

# Stripe (clés live, pas les clés de test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CLASSIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CLASSIC_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_EVENT_PASS=

# EmailJS (envoi de l'email de réinitialisation de mot de passe, côté backend —
# EMAILJS_PRIVATE_KEY vient de dashboard.emailjs.com > Account > API Keys, à garder secrète)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=

# Tags d'image à déployer (laissés à "latest" pour suivre la branche main,
# ou fixés à un tag précis type "1.2.0" pour figer une version)
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Perf/capacité (valeurs par défaut déjà raisonnables pour une seule instance costaud —
# à ajuster seulement après un test de charge, voir deploy.md § Capacité)
DB_POOL_MAX_SIZE=20
TOMCAT_MAX_THREADS=400
CACHE_TTL_SECONDS=3

# Sauvegarde Postgres (pg_dump quotidien vers un stockage S3-compatible — voir
# deploy.md § Sauvegardes). BACKUP_S3_* correspond à un bucket dédié aux backups,
# distinct de tout autre usage S3 du projet.
BACKUP_S3_REGION=                      # ex. eu-west-3 (AWS) — requis même chez un provider non-AWS, voir sa doc
BACKUP_S3_ENDPOINT=                    # laisser vide pour AWS S3 ; sinon URL du provider (Backblaze B2, Scaleway, OVH, MinIO...)
BACKUP_S3_BUCKET=                      # bucket dédié aux backups (à créer chez le provider choisi)
BACKUP_S3_PREFIX=tournoi-center        # sous-dossier dans le bucket, utile si le bucket est partagé
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_SCHEDULE=@daily                 # syntaxe go-cron (ex. "0 3 * * *" pour 3h du matin)
BACKUP_KEEP_DAYS=14                    # rétention ; les backups plus anciens sont supprimés automatiquement
