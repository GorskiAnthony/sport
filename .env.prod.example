# Variables à renseigner dans Dokploy (onglet Environment du projet), PAS dans un fichier
# .env commité. Copie ce template comme référence.

# Postgres
POSTGRES_DB=tournoi_center
POSTGRES_USER=postgres
POSTGRES_PASSWORD=                     # généré avec: openssl rand -base64 24

# Backend
JWT_SECRET=                            # généré avec: openssl rand -base64 32
JWT_EXPIRATION_DAYS=7
CLIENT_URL=https://sport.example.com   # domaine du frontend en prod (utilisé pour CORS)

# Stripe (clés live, pas les clés de test)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CLASSIC=
STRIPE_PRICE_PRO=

# Tags d'image à déployer (laissés à "latest" pour suivre la branche main,
# ou fixés à un tag précis type "1.2.0" pour figer une version)
BACKEND_TAG=latest
FRONTEND_TAG=latest

# Perf/capacité (valeurs par défaut déjà raisonnables pour une seule instance costaud —
# à ajuster seulement après un test de charge, voir deploy.md § Capacité)
DB_POOL_MAX_SIZE=20
TOMCAT_MAX_THREADS=400
CACHE_TTL_SECONDS=3
