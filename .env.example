# Copie ce fichier en .env avant de lancer `docker compose up`.

POSTGRES_DB=tournoi_center
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

JWT_SECRET=change-me-please-32-bytes-minimum
CLIENT_URL=http://localhost:4200

# Stripe (optionnel en local)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CLASSIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_CLASSIC_ANNUAL=
STRIPE_PRICE_PRO_ANNUAL=
STRIPE_PRICE_EVENT_PASS=

# EmailJS (optionnel en local — sans ça, l'email de reset échoue silencieusement,
# voir dashboard.emailjs.com > Account > API Keys pour EMAILJS_PRIVATE_KEY)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
