# Copie ce fichier en .env (ou exporte ces variables dans ton environnement) avant de lancer l'API.

# Base de données PostgreSQL
DATABASE_URL=jdbc:postgresql://localhost:5432/tournoi_center
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

# Serveur
PORT=3000
SPRING_PROFILES_ACTIVE=dev

# Frontend autorisé en CORS (aussi utilisé pour les URLs de redirection Stripe)
CLIENT_URL=http://localhost:4200

# JWT (secret d'au moins 32 caractères en production)
JWT_SECRET=change-me-please-32-bytes-minimum
JWT_EXPIRATION_DAYS=7

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_CLASSIC=
STRIPE_PRICE_PRO=

# EmailJS (envoi de l'email de réinitialisation de mot de passe, côté backend —
# la clé privée est dans dashboard.emailjs.com > Account > API Keys)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
